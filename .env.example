APP_NAME=CollectFlow API
DATABASE_PATH=data/collectflow.db
CORS_ORIGINS=["http://localhost:3000"]

# Optional standalone trust service. This example is never loaded automatically.
TRUST_DATABASE_URL=postgresql://graceline@127.0.0.1:55432/graceline_trust
TRUST_JWT_SECRET=replace-with-at-least-32-random-bytes
TRUST_APPROVAL_SECRET=replace-with-different-32-random-bytes
TRUST_DEMO_AUTH_ENABLED=false
SIMULATION_MODE=true
