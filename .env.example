APP_NAME=CollectFlow API
# Local synthetic demo credentials only. Percent-encode URL password characters.
DATABASE_URL=postgresql://collectflow:local-demo-password@127.0.0.1:5432/collectflow
CORS_ORIGINS=["http://localhost:3000"]

# Compose PostgreSQL initialization. Match DATABASE_URL for host development.
POSTGRES_USER=collectflow
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=collectflow
POSTGRES_PORT=5432
BACKEND_PORT=8000
# Dedicated base test database. Test role must have CREATEDB for disposable databases.
TEST_DATABASE_URL=postgresql://collectflow_test:local-test-password@127.0.0.1:5433/collectflow_test
TEST_POSTGRES_PORT=5433

# Optional authenticated trust routes on the main API; disabled by default.
TRUST_ENABLED=false
# Empty means DATABASE_URL. Use Alembic on this database before trust startup.
TRUST_DATABASE_URL=
# Supply independent random keys of at least 32 bytes through the environment.
TRUST_JWT_SECRET=
TRUST_APPROVAL_SECRET=
# Local demo identity picker only. Keep false in the integrated backend.
TRUST_DEMO_AUTH_ENABLED=false
SIMULATION_MODE=true
