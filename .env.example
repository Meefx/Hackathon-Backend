APP_NAME=CollectFlow API
# Local synthetic demo credentials only. Percent-encode URL password characters.
DATABASE_URL=postgresql://collectflow:local-demo-password@127.0.0.1:5432/collectflow
CORS_ORIGINS=["http://localhost:3000"]

# Compose PostgreSQL initialization. Match DATABASE_URL for host development.
POSTGRES_USER=collectflow
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=collectflow
POSTGRES_PORT=5432
BACKEND_PORT=8000
# Dedicated base test database. Test role must have CREATEDB for disposable databases.
TEST_DATABASE_URL=postgresql://collectflow_test:local-test-password@127.0.0.1:5433/collectflow_test
TEST_POSTGRES_PORT=5433

# Explicit synthetic demo only. Run app.seed after migration to provision demo recipients/policy.
DEMO_FIXTURE_ENABLED=true
KNOWLEDGE_MODE=demo_fixture
# Friend-owned in-process KM: mode=in_process and module.path:factory returning KnowledgeGateway.
KNOWLEDGE_SERVICE_FACTORY=
# Replace with a high-entropy value before exposing a shared environment.
APPROVAL_HMAC_SECRET=local-synthetic-demo-change-before-sharing
APPROVAL_TTL_SECONDS=900
WORKER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_RUNTIME_DEADLINE_SECONDS=300
# Hermes API server host URL; use host.docker.internal for host runtime from Compose.
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_PROFILE=
HERMES_TIMEOUT_SECONDS=20
# Separate Hermes->MCP opaque bearer credential. Require UTC timezone-aware expiry.
MCP_BEARER_TOKEN=
MCP_PRINCIPAL_ID=hermes-agent
# MCP_TOKEN_EXPIRES_AT=2026-11-08T00:00:00Z
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
# Per-statement PostgreSQL bounds, milliseconds; transaction cleanup remains synchronous.
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=2000
# Optional authenticated trust routes on the main API; disabled by default.
TRUST_ENABLED=false
# Empty means DATABASE_URL. Use Alembic on this database before trust startup.
TRUST_DATABASE_URL=
# Supply independent random keys of at least 32 bytes through the environment.
TRUST_JWT_SECRET=
TRUST_APPROVAL_SECRET=
# Local demo identity picker only. Keep false in the integrated backend.
TRUST_DEMO_AUTH_ENABLED=false
SIMULATION_MODE=true
